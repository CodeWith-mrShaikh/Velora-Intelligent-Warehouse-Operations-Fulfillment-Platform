generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── USER ──────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  WAREHOUSE_MANAGER
  STAFF
  PICKER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(STAFF)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders         Order[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@map("users")
}

// ─── WAREHOUSE ─────────────────────────────────────────────────────────────────

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Warehouse {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  address   String?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  rows WarehouseRow[]

  @@map("warehouses")
}

// ─── WAREHOUSE ROW ─────────────────────────────────────────────────────────────

model WarehouseRow {
  id          String       @id @default(uuid())
  warehouseId String       @map("warehouse_id")
  code        String
  name        String
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bins      Bin[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@map("warehouse_rows")
}

// ─── BIN ───────────────────────────────────────────────────────────────────────

enum BinStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Bin {
  id           String    @id @default(uuid())
  rowId        String    @map("row_id")
  code         String
  locationCode String    @unique @map("location_code")
  capacity     Int       @default(100)
  status       BinStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  row                WarehouseRow    @relation(fields: [rowId], references: [id])
  inventories        Inventory[]
  orderItems         OrderItem[]
  sourceMovements    StockMovement[] @relation("SourceBin")
  destinationMovements StockMovement[] @relation("DestinationBin")

  @@unique([rowId, code])
  @@index([rowId])
  @@index([locationCode])
  @@map("bins")
}

// ─── PRODUCT ───────────────────────────────────────────────────────────────────

model Product {
  id           String       @id @default(uuid())
  sku          String       @unique
  barcode      String?      @unique
  name         String
  description  String?
  category     String?
  unitPrice    Decimal      @default(0) @map("unit_price")
  reorderLevel Int          @default(10) @map("reorder_level")
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  inventories    Inventory[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([sku])
  @@index([barcode])
  @@index([name])
  @@index([category])
  @@map("products")
}

// ─── INVENTORY ─────────────────────────────────────────────────────────────────

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  binId            String   @map("bin_id")
  onHandQuantity   Int      @default(0) @map("on_hand_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  bin     Bin     @relation(fields: [binId], references: [id])

  @@unique([productId, binId])
  @@index([productId])
  @@index([binId])
  @@map("inventory")
}

// ─── ORDER ─────────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  ALLOCATED
  RESERVED
  PICKING
  PICKED
  COMPLETED
  CANCELLED
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique @map("order_number")
  customerReference String?     @map("customer_reference")
  status            OrderStatus @default(PENDING)
  totalAmount       Decimal     @default(0) @map("total_amount")
  createdBy         String?     @map("created_by")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  creator User?       @relation(fields: [createdBy], references: [id])
  items   OrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// ─── ORDER ITEM ────────────────────────────────────────────────────────────────

enum OrderItemStatus {
  PENDING
  ALLOCATED
  RESERVED
  PICKING
  PICKED
  CANCELLED
}

model OrderItem {
  id                String          @id @default(uuid())
  orderId           String          @map("order_id")
  productId         String          @map("product_id")
  requestedQuantity Int             @map("requested_quantity")
  allocatedQuantity Int             @default(0) @map("allocated_quantity")
  reservedQuantity  Int             @default(0) @map("reserved_quantity")
  pickedQuantity    Int             @default(0) @map("picked_quantity")
  allocatedBinId    String?         @map("allocated_bin_id")
  status            OrderItemStatus @default(PENDING)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  bin     Bin?    @relation(fields: [allocatedBinId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── STOCK MOVEMENT ────────────────────────────────────────────────────────────

enum MovementType {
  INWARD
  OUTWARD
  TRANSFER
  ADJUSTMENT
  RESERVATION
  RELEASE
  RETURN
}

model StockMovement {
  id               String       @id @default(uuid())
  movementType     MovementType @map("movement_type")
  productId        String       @map("product_id")
  sourceBinId      String?      @map("source_bin_id")
  destinationBinId String?      @map("destination_bin_id")
  quantity         Int
  referenceType    String?      @map("reference_type")
  referenceId      String?      @map("reference_id")
  performedBy      String?      @map("performed_by")
  reason           String?
  idempotencyKey   String?      @unique @map("idempotency_key")
  createdAt        DateTime     @default(now()) @map("created_at")

  product        Product @relation(fields: [productId], references: [id])
  sourceBin      Bin?    @relation("SourceBin", fields: [sourceBinId], references: [id])
  destinationBin Bin?    @relation("DestinationBin", fields: [destinationBinId], references: [id])
  performer      User?   @relation(fields: [performedBy], references: [id])

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// ─── AUDIT LOG ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeData String?  @map("before_data")
  afterData  String?  @map("after_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── IDEMPOTENCY KEY ───────────────────────────────────────────────────────────

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  response  String?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
